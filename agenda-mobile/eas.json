      "env": {
        "EXPO_PUBLIC_BOOKING_APP_URL": "https://lash-agenda-plum.vercel.app",
        "EXPO_PUBLIC_WEB_APP_URL": "https://lash-agenda-plum.vercel.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
